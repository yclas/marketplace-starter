# Your Yclas site (no trailing slash)
VITE_YCLAS_URL=https://newfeatures.yclas.com

# The site's API key, from your Yclas panel (Settings > General, or the starter prompt on
# Integrations > Your own front end). It is public by design: the mobile apps carry it too.
# Only sign-up and login use it. NEVER put a key that starts with yck_ here.
VITE_YCLAS_SITE_KEY=

# Shown in the header and page titles
VITE_SITE_NAME=Marketplace

# 1 = while developing, the dev server forwards /api to VITE_YCLAS_URL (no CORS setup needed yet)
VITE_YCLAS_PROXY=0
